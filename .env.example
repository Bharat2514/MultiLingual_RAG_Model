# =============================================================================
# PolyDoc — Multilingual RAG Assistant
# Copy to `.env` and fill in. Never commit `.env`.
# Nested settings use a double-underscore delimiter: GROUP__FIELD
# =============================================================================

# --- Application -------------------------------------------------------------
APP__ENV=development                  # development | staging | production
APP__DEBUG=true
APP__API_PREFIX=/api/v1
APP__CORS_ORIGINS=["http://localhost:3000"]
APP__SESSION_SECRET=change-me-to-a-long-random-string

# --- Storage -----------------------------------------------------------------
STORAGE__BACKEND=local                # local | s3
STORAGE__LOCAL_DIR=./data/uploads
# STORAGE__S3_BUCKET=
# STORAGE__S3_ENDPOINT_URL=
# STORAGE__S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Limits (FR-2) -----------------------------------------------------------
LIMITS__MAX_FILE_MB=50
LIMITS__MAX_PAGES=300
LIMITS__MAX_FILES_PER_SESSION=25

# --- Postgres ----------------------------------------------------------------
# Host-run API against docker-compose Postgres:
DB__URL=postgresql+asyncpg://polydoc:polydoc@localhost:5432/polydoc
DB__ECHO=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20

# --- Redis (cache + Celery broker) -------------------------------------------
REDIS__URL=redis://localhost:6379/0
REDIS__CELERY_BROKER_DB=1
REDIS__CELERY_RESULT_DB=2

# --- Qdrant ------------------------------------------------------------------
QDRANT__URL=http://localhost:6333
# QDRANT__API_KEY=
QDRANT__COLLECTION=polydoc_chunks
QDRANT__PREFER_GRPC=false

# --- Embeddings (bge-m3: dense + learned sparse in one pass) -----------------
EMBEDDING__MODEL_NAME=BAAI/bge-m3
EMBEDDING__DEVICE=auto                # auto | mps | cuda | cpu
EMBEDDING__USE_FP16=true
EMBEDDING__MAX_LENGTH=1024
EMBEDDING__BATCH_SIZE=8
EMBEDDING__DENSE_DIM=1024
EMBEDDING__CACHE_DIR=./data/models

# --- Reranker ----------------------------------------------------------------
RERANKER__ENABLED=true
RERANKER__MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER__DEVICE=auto
RERANKER__USE_FP16=true
RERANKER__BATCH_SIZE=8
RERANKER__MAX_LENGTH=1024

# --- Retrieval (FR-17, FR-18) ------------------------------------------------
RETRIEVAL__TOP_K=20
RETRIEVAL__TOP_N=5
RETRIEVAL__RRF_K=60
RETRIEVAL__HYBRID_ENABLED=true
RETRIEVAL__MIN_RERANK_SCORE=-2.0
RETRIEVAL__DUAL_QUERY_HINGLISH=true
# Hybrid fusion weights. Measured on eval/crosslingual_probe.py: equal-weight
# RRF scored WORSE than dense alone on cross-lingual queries (57% vs 100%
# recall@1), because a Hindi query shares no tokens with an English passage.
# Sparse still earns its keep on exact terms, so it is down-weighted, not cut.
RETRIEVAL__DENSE_WEIGHT=0.75
RETRIEVAL__SPARSE_WEIGHT=0.25
# Compile model kernels at startup. Measured cold, the first query took 14.8s
# and settled at 0.37s; with warmup the first query is ~1.7s.
RETRIEVAL__WARMUP_ON_STARTUP=true

# --- Chunking (FR-8, §11.2) --------------------------------------------------
CHUNKING__TARGET_TOKENS=550
CHUNKING__MIN_TOKENS=200
CHUNKING__MAX_TOKENS=800
CHUNKING__OVERLAP_RATIO=0.12

# --- OCR (FR-3, FR-4, §11.1) -------------------------------------------------
OCR__ENGINE=tesseract                 # tesseract | none
OCR__LANGS=hin+eng
OCR__DPI=300
OCR__MIN_CHARS_PER_PAGE=50
OCR__PREPROCESS=true
OCR__MAX_WORKERS=4

# --- LLM ---------------------------------------------------------------------
# Set the key for whichever provider you select below; the other can stay empty.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

LLM__PROVIDER=gemini                  # gemini | anthropic | ollama | mock
# Leave LLM__MODEL blank to use the provider default; `make check-llm`
# prints the exact model IDs your key can reach.
LLM__MODEL=
LLM__MAX_TOKENS=4096
LLM__TEMPERATURE=0.2                  # low: answers must track the context
LLM__EFFORT=medium                    # low | medium | high
LLM__THINKING=false
LLM__TIMEOUT_SECONDS=120
LLM__MAX_RETRIES=2
# Per-million-token prices used for the NFR-4 cost tracking in query_logs.
LLM__INPUT_COST_PER_MTOK=0.30
LLM__OUTPUT_COST_PER_MTOK=2.50
# Fully offline mode: LLM__PROVIDER=ollama runs generation on a local model, so
# no document text leaves the machine (embeddings are already local).
# LLM__OLLAMA_BASE_URL=http://localhost:11434
# LLM__MODEL=qwen2.5:7b-instruct

# --- Trust & verification ----------------------------------------------------
# Mask Aadhaar / PAN / phone / bank / IFSC / e-mail in context sent to a remote
# LLM (skipped for ollama — nothing leaves the machine).
TRUST__REDACT_PII_FOR_LLM=true
# Withhold retrieved passages that carry instructions aimed at the model.
TRUST__FILTER_INJECTED_CONTEXT=true
# Check every answer sentence against the passage it cites.
TRUST__VERIFY_CLAIMS=true
# Use the cross-encoder to judge claim wording (adds rerank-sized latency, but
# is the only way to check a Hindi answer against an English source).
TRUST__VERIFY_WITH_CROSS_ENCODER=false

# --- Conversation & cache ----------------------------------------------------
CONVERSATION__MAX_HISTORY_TURNS=6
CONVERSATION__REWRITE_FOLLOWUPS=true
CACHE__ENABLED=true
CACHE__TTL_SECONDS=900

# --- Observability -----------------------------------------------------------
OBS__LOG_LEVEL=INFO
OBS__JSON_LOGS=false                  # true in production
OBS__METRICS_ENABLED=true
# OBS__LANGFUSE_PUBLIC_KEY=
# OBS__LANGFUSE_SECRET_KEY=
# OBS__LANGFUSE_HOST=https://cloud.langfuse.com

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
