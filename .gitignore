# the repo live under backend/tests/fixtures/ or eval/corpus/.
/*.pdf
/*.docx

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp

# Evaluation output. `baseline.json` is committed on purpose — it is the
# reference the CI regression gate compares against.
eval/results/*
!eval/results/baseline.json

gitSetup/
resdocs/
